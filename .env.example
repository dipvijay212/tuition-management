# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for creating user accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Public URL of the app (used in invitation / password reset emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret for scheduled job endpoint (/api/cron/*). Vercel Cron sends it as Bearer token.
CRON_SECRET=change-me-to-a-long-random-string
