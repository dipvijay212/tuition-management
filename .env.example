# Copy to .env and fill in.
# URL of the Express backend (../backend). Only the Next.js server calls it.
API_URL=http://localhost:4000
# Shared secret; must equal API_INTERNAL_KEY in the backend's .env. SERVER ONLY.
API_INTERNAL_KEY=generate-a-long-random-string
# Public URL of this app
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Shown on institutes' Subscription page (how to renew/upgrade; no payment gateway yet). Optional.
SUPPORT_EMAIL=
SUPPORT_PHONE=
# WhatsApp number with country code, e.g. 919876543210
SUPPORT_WHATSAPP=
